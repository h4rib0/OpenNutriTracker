# Dummy .env sample for local testing
FDC_API_KEY="your_fdc_api_key"
SENTRY_DNS="https://example@sentry.io/0"
SUPABASE_PROJECT_URL="https://your-supabase-project.supabase.co"
SUPABASE_PROJECT_ANON_KEY="your_anon_key"

# Fastlane / signing secrets (use GitHub Secrets in CI)
APP_STORE_CONNECT_API_KEY="{\"key_id\":\"...\", \"issuer_id\":\"...\", \"private_key\":\"...\"}"
FASTLANE_APP_SPECIFIC_PASSWORD="app-specific-password-if-needed"

PLAY_STORE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\", ... }"

# Android keystore (base64) and passwords
ANDROID_KEYSTORE_BASE64=""
ANDROID_KEYSTORE_PASSWORD="your_keystore_password"
ANDROID_KEY_ALIAS="your_key_alias"
ANDROID_KEY_PASSWORD="your_key_password"

# fastlane match (iOS) git repo + password
MATCH_GIT_URL=""
MATCH_PASSWORD=""
